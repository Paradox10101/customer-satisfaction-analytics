# =====================================================
# Customer Satisfaction Analytics - .gitignore
# =====================================================

# ─────────────────────────────────────────────────────
# Python
# ─────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Tests / coverage
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# ─────────────────────────────────────────────────────
# Type checkers / linters
# ─────────────────────────────────────────────────────
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# ─────────────────────────────────────────────────────
# Notebooks / IDEs
# ─────────────────────────────────────────────────────
.ipynb_checkpoints
profile_default/
ipython_config.py
.idea/
.vscode/
.spyderproject
.spyproject
.ropeproject

# Claude Code settings locales
.claude/settings.local.json

# ─────────────────────────────────────────────────────
# Virtual environments
# ─────────────────────────────────────────────────────
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/
.python-version
Pipfile.lock
poetry.lock
.pdm.toml
__pypackages__/

# ─────────────────────────────────────────────────────
# OS
# ─────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# ─────────────────────────────────────────────────────
# AWS / Credentials
# ─────────────────────────────────────────────────────
.aws/
aws-exports.js
amplify-gradle-config.json
amplifytools.xcconfig
.secret-*
*.pem

# Archivos con account ID en el nombre
setup_account_*.py
!scripts/setup_account.py

# ─────────────────────────────────────────────────────
# Terraform
# ─────────────────────────────────────────────────────
*.tfstate
*.tfstate.*
*.tfvars
.terraform/
.terraform.lock.hcl
terraform.tfplan
crash.log
crash.*.log

# ─────────────────────────────────────────────────────
# Datos
# ─────────────────────────────────────────────────────
*.parquet
*.xlsx
*.db
*.sqlite

# Datos generados — preservamos solo .gitkeep
data/raw/*
data/processed/*
data/simulated/*
data/external/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/simulated/.gitkeep
!data/external/.gitkeep
!data/dummy/

# JSONs de runtime/output (terraform state plain, credenciales, etc.)
# NOTA: NO ignoramos *.json globalmente — politicas IAM y configs si se commitean
*tfstate*.json
*credentials*.json
*aws-credentials*.json
.aws/credentials.json

# ─────────────────────────────────────────────────────
# Modelos ML
# ─────────────────────────────────────────────────────
*.pkl
*.joblib
*.h5
*.pb
models/
checkpoints/

# ─────────────────────────────────────────────────────
# Logs
# ─────────────────────────────────────────────────────
logs/
*.log

# ─────────────────────────────────────────────────────
# Variables de entorno por entorno
# ─────────────────────────────────────────────────────
.env.local
.env.development
.env.test
.env.production

# ─────────────────────────────────────────────────────
# Secretos y configuracion sensible
# ─────────────────────────────────────────────────────
secrets/
credentials/
config/production/

# ─────────────────────────────────────────────────────
# Archivos comprimidos / temporales
# ─────────────────────────────────────────────────────
*.zip
*.tar.gz
*.tgz
*.rar
tmp/
temp/
*.tmp
*.temp

# ─────────────────────────────────────────────────────
# Documentacion
# ─────────────────────────────────────────────────────
docs/_build/
/site

# ─────────────────────────────────────────────────────
# Otros
# ─────────────────────────────────────────────────────
.scrapy
.webassets-cache
local_settings.py
db.sqlite3
db.sqlite3-journal
instance/
.pybuilder/
target/
celerybeat-schedule
celerybeat.pid
*.sage.py
*.mo
*.pot
cython_debug/
